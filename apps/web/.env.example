# Copy to apps/web/.env locally. Never commit real values.
#
# Secret Manager keys (GCP project experiment-jegf / 42206083192):
#   DATABASE_URL, AUTH_SECRET, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET,
#   GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, GITHUB_APP_CLIENT_ID,
#   GITHUB_APP_CLIENT_SECRET, GITHUB_APP_ID, GITHUB_APP_SLUG, CDP_* (except
#   CDP_WEBHOOK_SECRET — 0 versions). AUTH_URL after live Cloud Run origin.
#   CRON_SECRET / AUTH_TRUST_HOST are not in SM (TRUST_HOST=true is plain env).
# Ops sets secret versions out-of-band. Do not invent Cloud SQL passwords or OAuth secrets.
# Staging deploy map: docs/staging-deploy.md

# Local Docker Compose (repo-root docker-compose.yml) — placeholder user only.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/github_bounties

# Cloud SQL Auth Proxy on localhost (password from Secret Manager, never git):
# DATABASE_URL=postgresql://gb_app:PASSWORD@127.0.0.1:5432/github_bounties?sslmode=require

# Cloud Run unix socket — SM source shape. Runtime extracts host= as options.host
# and strips that query key before postgres.js connect:
# DATABASE_URL=postgresql://gb_app:PASSWORD@localhost/github_bounties?host=/cloudsql/experiment-jegf:us-central1:github-bounties-staging

DATABASE_URL=

# --- Google Sign-In (V1-2, Auth.js / NextAuth Google provider) ---
# Secret Manager keys (experiment-jegf / 42206083192). Never commit real values.
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (staging Cloud Run): https://<service>-<hash>-<region>.a.run.app/api/auth/callback/google
# See docs/google-signin.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth.js cookie encryption. Generate locally (npx auth secret). Secret Manager key AUTH_SECRET.
AUTH_SECRET=

# Optional public origin (local default is http://localhost:3000).
# Staging Cloud Run: first deploy AUTH_TRUST_HOST=true (plain env, not SM).
# After the live origin exists, store it as Secret Manager AUTH_URL (not in git).
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# --- GitHub App (V1-3, repo authority + webhooks) ---
# Secret Manager keys (experiment-jegf / 42206083192). Never commit real values.
# Webhook URL: {PUBLIC_BASE_URL}/webhooks/github
# Setup URL: {PUBLIC_BASE_URL}/github/setup
# Callback URL: {PUBLIC_BASE_URL}/github/callback
# See docs/github-app.md and docs/webhooks.md
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# --- Hugging Face connect (optional). Not product login. Google stays the sign-in. ---
# Secret Manager keys HF_OAUTH_CLIENT_ID and HF_OAUTH_CLIENT_SECRET.
# Optional on Cloud Run (WEB_OPTIONAL_SECRETS): missing secrets hide Connect and
# the routes return 503 hf_not_configured. Do not commit real values.
# Register the redirect URI on the HF OAuth app. Origin is PUBLIC_BASE_URL, then AUTH_URL.
#   DEV:   https://dev.githubbounties.xyz/huggingface/callback
#   PROD:  https://githubbounties.xyz/huggingface/callback
#   Local: http://localhost:3000/huggingface/callback
# HF_OAUTH_CLIENT_ID=
# HF_OAUTH_CLIENT_SECRET=
# Optional token for public issue reads and the DEV merge poller (higher rate limit).
# Unauthenticated GitHub REST works without it. Never commit a real token.
# DEV only — do not require this on PROD.
# GITHUB_PUBLIC_READ_TOKEN=
# PUBLIC_BASE_URL=https://github-bounties-staging.example.com
# Open Graph + Twitter image URLs ({origin}/og.png) use this origin, then
# AUTH_URL, then the request host. Set the public https origin on each
# environment so WhatsApp (and Slack/X) can fetch the logo:
#   DEV  https://dev.githubbounties.xyz
#   PROD https://githubbounties.xyz
# The absolute URL is chosen per request at runtime (not baked at image build).

# Optional. If set, expire-claim-locks and poll-public-merges require Authorization: Bearer <CRON_SECRET>.
# Schedule poll-public-merges on DEV only. Do not remount PROD.
# CRON_SECRET=

# --- CDP / x402 (V1-5 escrow). Same Secret Manager names as repo-root .env.example ---
# GCP experiment-jegf / 42206083192. Never commit values. Ops stashes versions OOB.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_PROJECT_ID=
CDP_CLIENT_API_KEY=
CDP_NETWORK=base-sepolia
CDP_DRY_RUN=1
# CDP_DRY_RUN_LIVE=1
# Client fund / WalletConnect chain follows CDP_NETWORK (same gate as the rail).
# PROD only: CDP_NETWORK=base and CDP_ALLOW_MAINNET=1 (see docs/prod-cutover.md).
# CDP_ALLOW_MAINNET=1
# Read-only bookkeeping tool: npm run security:derive-corrections
# PROD: Base mainnet JSON-RPC (chain id 8453) with CDP_NETWORK=base and CDP_ALLOW_MAINNET=1.
# DEV: Base Sepolia JSON-RPC (chain id 84532) with CDP_NETWORK=base-sepolia.
# The tool never writes to Postgres. See docs/security/README.md.
# BASE_RPC_URL=

# --- WalletConnect (V1.5 fund UX). Public Reown Cloud project id — not a secret. ---
# Create at https://dashboard.reown.com (WalletConnect Cloud). Allow
# https://dev.githubbounties.xyz, http://localhost:3000, and (PROD)
# https://githubbounties.xyz. WC metadata url/icons use PUBLIC_BASE_URL
# or AUTH_URL (localhost fallback).
# Cloud Run: plain --set-env-vars (not Secret Manager). The server passes this
# into the browser connector so a runtime set is enough (no image rebuild).
# WalletConnect QR is disabled until this is set; injected browser wallets still work.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# x402 exact seller uses PUBLIC_BASE_URL / AUTH_URL as the resource origin.
# No new CDP secret names. Hosted checkout stays disabled.

# --- Gemini (V3-0 bounty intelligence, server-side only) ---
# Secret Manager key GEMINI_API_KEY (experiment-jegf). Never NEXT_PUBLIC_*.
# Optional: bounty page still works without it (intelligence card degrades).
# DEV remounts attach this when an enabled SM version exists. Not wired on PROD.
# GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash). Server-only.
# GEMINI_MODEL=

# --- Transactional email (V3.x A1, server-side only, DEV) ---
# Secret Manager key RESEND_API_KEY (experiment-jegf). Never NEXT_PUBLIC_*.
# Optional: sign-in still works; welcome stays pending until the key exists.
# Not wired on PROD. See docs/email.md.
# RESEND_API_KEY=
# Plain env, not a secret. Verified sender. Default is the noreply address below.
# EMAIL_FROM=GitHub Bounties <noreply@githubbounties.xyz>
# Optional campaign audience. Unset means marketing contact sync is a no-op.
# Secret Manager key RESEND_AUDIENCE_ID. WEB_OPTIONAL_SECRETS. Never NEXT_PUBLIC_*.
# RESEND_AUDIENCE_ID=
# Svix signing secret for POST /api/webhooks/resend. Unset rejects the webhook.
# Secret Manager key RESEND_WEBHOOK_SECRET. WEB_OPTIONAL_SECRETS.
# RESEND_WEBHOOK_SECRET=

# --- Public API keys (V4-2) ---
# Secret Manager key API_KEY_HMAC_SECRET. Never NEXT_PUBLIC_*. 16+ characters.
# DEV: create the secret, then remount (WEB_OPTIONAL_SECRETS attaches it when
# an enabled version exists). Keys fail closed until it is set.
# API_KEY_HMAC_SECRET=
# Plain env. Unset means money ON on base-sepolia and OFF on base.
# API_MONEY_ENABLED=
# Optional admin spend ceilings (users can only lower their keys).
# API_PER_TX_CAP_USDC=
# API_DAILY_CAP_USDC=

# --- Admin console (V5 PR C). Same Cloud Run service as the public site. ---
# Comma-separated Google emails. Compared lowercase. Unset means nobody is admin.
# Pin: the session Google subject must match users.google_sub when both are set.
# ADMIN_EMAILS=you@example.com
# Admin refunds stay off until this is exactly 1. Public REST and MCP money
# actions stay gated by API_MONEY_ENABLED. Set 1 on PROD (and optionally DEV)
# to let an admin session refund. Leave API_MONEY_ENABLED unset or 0 on PROD.
# ADMIN_REFUND_ENABLED=
# Fee withdraw stays off until this is exactly 1. API_MONEY_ENABLED does not enable it.
# A withdraw preview writes an admin audit row and mints a 5-minute confirm token.
# It does not send USDC, and it is not a read-only action.
# ADMIN_WITHDRAW_ENABLED=
# Checksummed gb-fee address. Withdraw aborts if getAccount({name:'gb-fee'}) differs.
# FEE_WALLET_ADDRESS=
# AUTH_URL stays the public origin. Do not unset it and do not point it at an
# admin host. trustHost does not override AUTH_URL (next-auth reqWithEnvURL
# and createActionURL). The admin-host decision reads Host only. Cloud Run
# sets Host to the mapped domain. Client X-Forwarded-Host is ignored. The
# origin is the pinned hostname, not the raw header. No ADMIN_BASE_URL.
#   DEV:  AUTH_URL=https://dev.githubbounties.xyz
#         PUBLIC_BASE_URL=https://dev.githubbounties.xyz
#   PROD: AUTH_URL=https://githubbounties.xyz
#         PUBLIC_BASE_URL=https://githubbounties.xyz
# Google redirect URIs (admin ones are already registered):
#   https://admin-dev.githubbounties.xyz/api/auth/callback/google
#   https://admin.githubbounties.xyz/api/auth/callback/google
# Local screenshots only. Ignored when NODE_ENV=production.
# ADMIN_UI_FIXTURE=

