# Copy to apps/web/.env locally. Never commit real values.
#
# Secret Manager keys (GCP project experiment-jegf / 42206083192):
#   DATABASE_URL, AUTH_SECRET, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET,
#   GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, GITHUB_APP_CLIENT_ID,
#   GITHUB_APP_CLIENT_SECRET, GITHUB_APP_ID, GITHUB_APP_SLUG, CDP_* (except
#   CDP_WEBHOOK_SECRET — 0 versions). AUTH_URL after live Cloud Run origin.
#   CRON_SECRET / AUTH_TRUST_HOST are not in SM (TRUST_HOST=true is plain env).
# Ops sets secret versions out-of-band. Do not invent Cloud SQL passwords or OAuth secrets.
# Staging deploy map: docs/staging-deploy.md

# Local Docker Compose (repo-root docker-compose.yml) — placeholder user only.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/github_bounties

# Cloud SQL Auth Proxy on localhost (password from Secret Manager, never git):
# DATABASE_URL=postgresql://gb_app:PASSWORD@127.0.0.1:5432/github_bounties?sslmode=require

# Cloud Run unix socket (`localhost` so Node can parse; runtime sets postgres.js options.host from host=):
# DATABASE_URL=postgresql://gb_app:PASSWORD@localhost/github_bounties?host=/cloudsql/experiment-jegf:us-central1:github-bounties-staging

DATABASE_URL=

# --- Google Sign-In (V1-2, Auth.js / NextAuth Google provider) ---
# Secret Manager keys (experiment-jegf / 42206083192). Never commit real values.
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (staging Cloud Run): https://<service>-<hash>-<region>.a.run.app/api/auth/callback/google
# See docs/google-signin.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth.js cookie encryption. Generate locally (npx auth secret). Secret Manager key AUTH_SECRET.
AUTH_SECRET=

# Optional public origin (local default is http://localhost:3000).
# Staging Cloud Run: first deploy AUTH_TRUST_HOST=true (plain env, not SM).
# After the live origin exists, store it as Secret Manager AUTH_URL (not in git).
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# --- GitHub App (V1-3, repo authority + webhooks) ---
# Secret Manager keys (experiment-jegf / 42206083192). Never commit real values.
# Webhook URL: {PUBLIC_BASE_URL}/webhooks/github
# Setup URL: {PUBLIC_BASE_URL}/github/setup
# Callback URL: {PUBLIC_BASE_URL}/github/callback
# See docs/github-app.md and docs/webhooks.md
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# PUBLIC_BASE_URL=https://github-bounties-staging.example.com

# Optional. If set, GET|POST /api/jobs/expire-claim-locks requires Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=

# --- CDP / x402 (V1-5 escrow). Same Secret Manager names as repo-root .env.example ---
# GCP experiment-jegf / 42206083192. Never commit values. Ops stashes versions OOB.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_PROJECT_ID=
CDP_CLIENT_API_KEY=
CDP_NETWORK=base-sepolia
CDP_DRY_RUN=1
# CDP_DRY_RUN_LIVE=1
# CDP_ALLOW_MAINNET=1

