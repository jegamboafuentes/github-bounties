# Copy to apps/web/.env locally. Never commit real values.
#
# Secret Manager keys (GCP project experiment-jegf / 42206083192):
#   DATABASE_URL, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, AUTH_SECRET
# Ops sets secret versions out-of-band. Do not invent Cloud SQL passwords or OAuth secrets.

# Local Docker Compose (repo-root docker-compose.yml) — placeholder user only.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/github_bounties

# Cloud SQL Auth Proxy on localhost (password from Secret Manager, never git):
# DATABASE_URL=postgresql://gb_app:PASSWORD@127.0.0.1:5432/github_bounties?sslmode=require

# Cloud Run unix socket:
# DATABASE_URL=postgresql://gb_app:PASSWORD@/github_bounties?host=/cloudsql/experiment-jegf:us-central1:github-bounties-staging

DATABASE_URL=

# --- Google Sign-In (V1-2, Auth.js / NextAuth Google provider) ---
# Secret Manager keys (experiment-jegf / 42206083192). Never commit real values.
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (staging Cloud Run): https://<service>-<hash>-<region>.a.run.app/api/auth/callback/google
# See docs/google-signin.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth.js cookie encryption. Generate locally (npx auth secret). Secret Manager key AUTH_SECRET.
AUTH_SECRET=

# Optional public origin (local default is http://localhost:3000).
# AUTH_URL=http://localhost:3000

