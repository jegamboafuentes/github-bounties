# Copy to .env locally. Never commit real values.

# --- Postgres (V1-1) ---
# Secret Manager key: DATABASE_URL (GCP experiment-jegf / 42206083192).
# Ops sets the version out-of-band. Do not invent Cloud SQL passwords.
# Local: docker compose up -d postgres (placeholder role in docker-compose.yml).
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/github_bounties
DATABASE_URL=

# --- Google Sign-In (V1-2) ---
# Secret Manager keys on experiment-jegf / 42206083192. Placeholders only.
# Used by apps/web (Auth.js). See docs/google-signin.md
# Staging Cloud Run secret map: docs/staging-deploy.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_SECRET=

# --- GitHub App (V0-B stub + V1-3 apps/web) ---
# Required for POST /webhooks/github. GitHub App → Webhook secret (HMAC).
GITHUB_WEBHOOK_SECRET=

# Numeric App ID. Used by apps/web to confirm installations and fetch merge surfaces.
GITHUB_APP_ID=

# App slug for https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=

# GitHub App user-to-server OAuth (link github_links). Not product login.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# PEM contents (or \n-escaped). Secret Manager key GITHUB_APP_PRIVATE_KEY.
# Never commit the value. Optional local file alternative is gitignored.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-bounties-staging.pem

PORT=3000
HOST=127.0.0.1

# Public origin used in docs for staging callback / webhook / setup URLs.
PUBLIC_BASE_URL=https://github-bounties-staging.example.com

# File-backed delivery-id store (idempotency). Directory is created on start.
DELIVERY_STORE_PATH=.data/deliveries.json

# --- CDP / x402 (V0-A) ---
# GCP Secret Manager names match these env vars (project experiment-jegf / 42206083192).
# See docs/adr/0001-cdp-x402-wallets.md

# Required for any CDP wallet or x402 facilitator call
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Optional but recommended
CDP_PROJECT_ID=
CDP_CLIENT_API_KEY=

# Sandbox only. Dry-run / app refuse mainnet unless CDP_ALLOW_MAINNET=1.
CDP_NETWORK=base-sepolia
CDP_DRY_RUN=1
# CDP_DRY_RUN_LIVE=1
# CDP_ALLOW_MAINNET=1
# PUBLIC_BASE_URL / AUTH_URL are the x402 resource origin on DEV (already set on
# https://dev.githubbounties.xyz). No extra CDP secret names for x402 exact.
# Hosted checkout stays disabled — do not add Business checkout callbacks.
